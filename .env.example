# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/pcea-online-ministry

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://pceaonlineministry.com

# OpenAI — required for AI sermon processing pipeline
OPENAI_API_KEY=sk-your-openai-api-key-here

# Cloudflare R2 — required for file storage (audio + documents)
# R2_ENDPOINT: your S3-compatible endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY / R2_SECRET_KEY: from Cloudflare R2 → Manage API Tokens
# R2_BUCKET: the bucket name (must already exist in your Cloudflare account)
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pceaonline
