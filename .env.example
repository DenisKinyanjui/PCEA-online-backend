# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/pcea-online-ministry

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://pceaonlineministry.com

# AI provider — required for AI sermon processing pipeline (transcription + structuring)
# AI_PROVIDER selects the adapter in services/ai/ (currently only "mimo" is implemented)
AI_PROVIDER=mimo
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MiMo-V2.5-ASR: speech recognition (WAV/MP3 only, 10MB base64 payload limit)
MIMO_ASR_MODEL=mimo-v2.5-asr
# MiMo-V2.5: sermon analysis / structuring
MIMO_ANALYSIS_MODEL=mimo-v2.5
# Optional tuning:
# MIMO_ASR_LANGUAGE=auto   # auto | zh | en
# MIMO_TIMEOUT_MS=120000
# MIMO_MAX_RETRIES=2
# MIMO_RATE_LIMIT_RETRIES=6  # extra patient retries on 429 (5s, 10s, 20s … up to 60s)
# ASR_SEGMENT_DELAY_MS=3000  # pause between transcription segments
# ASR_CHUNK_SECONDS=600    # long sermons are transcribed in segments of this length

# Cloudflare R2 — required for file storage (audio + documents)
# R2_ENDPOINT: your S3-compatible endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY / R2_SECRET_KEY: from Cloudflare R2 → Manage API Tokens
# R2_BUCKET: the bucket name (must already exist in your Cloudflare account)
R2_ACCESS_KEY=your-r2-access-key-id
R2_SECRET_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=pceaonline
